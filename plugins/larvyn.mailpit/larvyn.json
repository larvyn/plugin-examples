{
  "apiVersion": 1,
  "id": "larvyn.mailpit",
  "name": "Mailpit",
  "version": "0.2.0",
  "description": "Catch the mail your app sends: runs Mailpit in the stack, shows the inbox in the sidebar, and points the app's mail settings at it.",
  "author": "Larvyn",
  "homepage": "https://mailpit.axllent.org",
  "larvyn": ">=0.1.0-beta.10",
  "permissions": [
    "terminal.run",
    "network",
    "project.env.keys",
    "ui.notify"
  ],
  "network": [
    "localhost:8025"
  ],
  "env": [
    "MAIL_MAILER",
    "MAIL_HOST",
    "MAIL_PORT"
  ],
  "requires": [
    {
      "program": "mailpit",
      "install": {
        "mac": "brew install mailpit",
        "linux": "curl -sL https://raw.githubusercontent.com/axllent/mailpit/develop/install.sh | sudo bash",
        "windows": "scoop install mailpit"
      },
      "url": "https://mailpit.axllent.org/docs/install/"
    }
  ],
  "contributes": {
    "stack": [
      {
        "key": "mailpit",
        "title": "Mailpit",
        "argv": [
          "mailpit",
          "--smtp",
          "127.0.0.1:1025",
          "--listen",
          "127.0.0.1:8025"
        ]
      }
    ],
    "views": [
      {
        "id": "inbox",
        "title": "Mail",
        "entry": "ui/index.html"
      }
    ]
  }
}
