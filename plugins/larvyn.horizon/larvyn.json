{
  "apiVersion": 1,
  "id": "larvyn.horizon",
  "name": "Horizon",
  "version": "0.1.1",
  "description": "Restart, pause and check Laravel Horizon from ⌘K. (Larvyn already adds Horizon to the stack when the app uses laravel/horizon.)",
  "author": "Larvyn",
  "homepage": "https://laravel.com/docs/horizon",
  "larvyn": ">=0.1.0",
  "permissions": ["terminal.run"],
  "contributes": {
    "commands": [
      {"id": "restart", "title": "Horizon: restart workers", "run": "php artisan horizon:terminate"},
      {"id": "status", "title": "Horizon: status", "run": "php artisan horizon:status"},
      {"id": "pause", "title": "Horizon: pause", "run": "php artisan horizon:pause"},
      {"id": "continue", "title": "Horizon: continue", "run": "php artisan horizon:continue"}
    ]
  }
}
